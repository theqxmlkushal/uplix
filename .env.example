# Copy to .env (never commit .env). Use the TRANSACTION POOLER string from Supabase
# (Connect button), password filled in. Every variable the customer app reads.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
SECRET_KEY=change-me-to-a-long-random-value

# Used by the admin side (Member B) later; set it now so the shared project is ready.
ADMIN_PASSWORD=change-me

# ML service (Vercel project 2), called server to server by the admin side.
ML_API_URL=https://<ml-project>.vercel.app
ML_API_KEY=same-random-value-in-both-projects

# Optional: caps the sign-in delay after 5 wrong PINs in a row (seconds, default 60).
# Lower it only in tests.
SIGNIN_DELAY_MAX=60
